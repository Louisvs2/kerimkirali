# Copy to .env.local for local development. Never commit real values.

# Canonical site URL, no trailing slash (used for metadata, sitemap, robots).
# Local: http://localhost:3000 — Production: the client's domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (https://resend.com). Without a key the
# form endpoint responds with an error — set before launch.
RESEND_API_KEY=
# Sender shown on form emails. Must belong to a domain verified in Resend;
# "onboarding@resend.dev" works for testing only.
CONTACT_FORM_FROM=Kontaktformular <onboarding@resend.dev>
# Recipient of form submissions. Falls back to siteConfig.contact.email.
CONTACT_FORM_TO=
